            "{{entryId}}"
          ]
        },
        "description": "Run at the specified publication stage. Credentials are stored only in private environment variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const product = pm.response.json();",
              "const marker = pm.environment.get(\"draftMarker\");",
              "pm.test(\"TC-006 | Delivery API returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"TC-006 | Correct product ID\", () => pm.expect(product.sys.id).to.eql(pm.environment.get(\"entryId\")));",
              "pm.test(\"TC-006 | Unpublished marker absent from Delivery\", () => pm.expect(product.fields.description).not.to.include(marker));"
            ]
          }
        }
      ],
      "response": []
    },
